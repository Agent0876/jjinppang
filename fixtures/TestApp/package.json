{
  "name": "TestApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "jjinppang start",
    "bundle": "jjinppang bundle",
    "android": "react-native run-android",
    "bundle:android": "jjinppang bundle --entry-file index.js --platform android --dev false --bundle-output dist/index.android.bundle --assets-dest dist/res",
    "ios": "react-native run-ios",
    "bundle:ios": "jjinppang bundle --entry-file index.js --platform ios --dev false --bundle-output dist/main.jsbundle --assets-dest dist/assets",
    "test": "jjinppang test",
    "lint": "jjinppang lint",
    "lint:fix": "jjinppang lint --fix",
    "format": "jjinppang format",
    "format:check": "jjinppang format --check",
    "check": "jjinppang lint && jjinppang format --check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/new-app-screen": "0.87.1",
    "jjinppang": "workspace:*",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.12.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@babel/runtime": "^8.0.5",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.3.0",
    "rollipop": "^1.0.0-alpha.29",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
