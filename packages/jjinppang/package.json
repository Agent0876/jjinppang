{
  "name": "jjinppang",
  "version": "0.1.0",
  "description": "Ultra-fast custom bundler CLI for React Native bare projects powered by Bun (찐빵 - jjinppang)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shinseungmin/jjinppang.git",
    "directory": "packages/jjinppang"
  },
  "bin": {
    "bun-rn": "./bin/bun-rn.js",
    "jjinppang": "./bin/jjinppang.js",
    "react-native-bun-build": "./bin/bun-rn.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "commands.js",
    "commands.cjs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./commands": {
      "require": "./commands.cjs",
      "import": "./commands.js",
      "default": "./commands.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@jjinppang/cli": "workspace:*",
    "@jjinppang/core": "workspace:*"
  }
}
