{
  "name": "@jjinppang/core",
  "version": "0.1.0",
  "description": "Core Bun.build bundling engine for React Native (찐빵 - jjinppang)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shinseungmin/jjinppang.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./resolver": "./src/resolver/index.ts",
    "./assets": "./src/assets/index.ts",
    "./babel": "./src/babel/index.ts",
    "./hermes": "./src/hermes/index.ts",
    "./diagnostics": "./src/diagnostics/index.ts",
    "./server": "./src/server/index.ts",
    "./bundler": "./src/bundler/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/core": "^8.0.5",
    "fast-flow-transform": "^0.0.3",
    "image-size": "^2.0.2",
    "source-map-js": "^1.2.1"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.13.0"
  }
}
