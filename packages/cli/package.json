{
  "name": "@jjinppang/cli",
  "version": "0.1.0",
  "description": "React Native CLI command plugin and standalone CLI for Bun bundler (찐빵 - jjinppang)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shinseungmin/jjinppang.git",
    "directory": "packages/cli"
  },
  "bin": {
    "bun-rn": "bin/jjinppang.js",
    "jjinppang": "bin/jjinppang.js",
    "react-native-bun-build": "bin/jjinppang.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./commands": "./dist/commands/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@jjinppang/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.2"
  }
}
